{
  "name": "GasStation DW",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "containerEnv": {
    "DBT_PROFILES_DIR": "${containerWorkspaceFolder}/Gasstation_dw_duckdb"
  },
  "postCreateCommand": "python3 -m venv .venv && .venv/bin/pip install --upgrade pip && .venv/bin/pip install -r requirements.txt && cd Gasstation_dw_duckdb && ../.venv/bin/dbt deps && ../.venv/bin/python load_raw.py",
  "forwardPorts": [8501],
  "portsAttributes": {
    "8501": {
      "label": "Streamlit App",
      "onAutoForward": "openPreview"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "python.terminal.activateEnvironment": true
      }
    }
  }
}
